# ==============================================================================
# EventBridge Environment Configuration Template
# Copy this file to .env in the server/ directory:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# ==============================================================================

# Port number on which the Express backend server listens
PORT=3000

# Environment mode ('development' or 'production')
# In 'production', cookies are marked as secure (HTTPS only)
NODE_ENV=development

# Supabase project URL (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase service role secret key (from Supabase Dashboard -> Project Settings -> API)
# WARNING: Keep this secret. Grants administrative access and bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Shared secret string used to verify incoming 'x-webhook-secret' headers
WEBHOOK_SECRET=your-webhook-secret-token-here

# Destination URL for downstream webhook forwarding
# Defaults to internal mock receiver if not set: http://localhost:3000/api/mock-downstream
DOWNSTREAM_URL=http://localhost:3000/api/mock-downstream

# Administrator password required to access the dashboard controls and retry endpoints
ADMIN_PASSWORD=your-admin-password-here

# Secret key used to sign and verify JSON Web Token (JWT) session cookies
SESSION_SECRET=your-long-random-session-secret-here

# Optional artificial response delay in milliseconds for mock downstream testing (default: 0)
DOWNSTREAM_DELAY_MS=0
